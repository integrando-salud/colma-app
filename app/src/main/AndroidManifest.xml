<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColmaApp"
        tools:targetApi="31">

        <activity
            android:name=".features.main.ui.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.ColmaApp">
        </activity>
        <activity android:name=".features.login.ui.LoginUI"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>


        </activity>

        <activity android:name=".features.sesiones.WelcomeActivity"
            android:exported="false"/>

        <activity android:name=".features.sesiones.ActionActivity"
            android:exported="false"/>

        <activity android:name=".features.sesiones.FinishActivity"
            android:exported="false"/>

        <activity android:name=".features.instructions.ui.InstructionsActivity"
            android:exported="false">
        </activity>

        <activity android:name=".features.MenuMain.MenuMain"
            android:exported="false">

        </activity>

        <activity android:name=".features.RegistroSalud.RegistrosSalud"
            android:exported="false"/>

        <activity android:name=".features.EstadoAnimoMenu.EstadoAnimoMenuActivity"
            android:exported="false"/>

        <activity android:name=".features.estadoAnimo.EstadoAnimoActivity"
            android:exported="false">


        </activity>

        <activity android:name=".utils.videoPlayer.FullscreenVideoActivity"
            android:screenOrientation="landscape" />
    </application>

</manifest>